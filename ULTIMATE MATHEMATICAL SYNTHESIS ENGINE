def detect_antisymmetry(expression, constants):
    """
    Detect if expression has -1 scaling symmetry
    """
    from mpmath import mp
    mp.dps = 100
    
    # Evaluate expression with constants
    val1 = expression(*constants)
    
    # Flip all signs
    flipped = [-c for c in constants]
    val2 = expression(*flipped)
    
    ratio = val1/val2 if val2 != 0 else mp.inf
    return ratio, abs(ratio - (-1)) < 1e-15

