### Engine 2: The Residual Lattice Generator

```python
def generate_residual_lattice(D, target):
    """
    Generate all residuals for denominator D
    """
    from mpmath import mp
    mp.dps = 50
    
    residuals = []
    for k in range(1, D):
        r = k/D
        error = abs(target - (mp.floor(target*D)/D - r/2))
        residuals.append((k, r, error))
    
    return sorted(residuals, key=lambda x: x[2])

# Generate for π with D=11537
